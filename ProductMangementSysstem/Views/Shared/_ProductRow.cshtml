
@model ProductMangementSysstem.Models.Product

<tr>

    <td>
        @Model.Name
    </td>

    <td>
        @Model.Category?.Name
    </td>

    <td>
        @Model.Price.ToString("C")
    </td>

    <td>
        @Model.Stock
    </td>

    <td>

        <a asp-controller="Product"
           asp-action="Details"
           asp-route-id="@Model.Id"
           class="btn btn-info btn-sm">
            Details
        </a>

        <a asp-controller="Product"
           asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-warning btn-sm">
            Edit
        </a>

        <a asp-controller="Product"
           asp-action="Delete"
           asp-route-id="@Model.Id"
           class="btn btn-danger btn-sm">
            Delete
        </a>

    </td>

</tr>
